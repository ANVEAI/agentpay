# Secret used to encrypt the Sign-In-With-Ethereum session cookie.
# Use a long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Merchant wallet that receives payments (the demo /api/premium route's payee).
AGENTPAY_PAYTO=0xYourWallet

# Admin token for programmatic provisioning via the CLI/API (coding agents). Keep it secret.
AGENTPAY_ADMIN_TOKEN=replace-with-a-long-random-token

# Public canonical URL of your deploy — used for the og:image + social link previews.
NEXT_PUBLIC_SITE_URL=https://agentpay.citerlabs.com

# Optional: a private Base Sepolia RPC for full payment history (defaults to the public RPC).
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
