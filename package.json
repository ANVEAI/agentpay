{
  "name": "agentpay",
  "version": "0.0.1",
  "private": true,
  "description": "AgentPay — the easiest way for merchants to accept AI-agent payments. x402-compatible, USDC, self-hosted.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @agentpay/dashboard dev",
    "build": "pnpm -r build",
