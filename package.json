    "typecheck": "pnpm -r typecheck",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "viem": "^2.21.0"
  },
  "packageManager": "pnpm@9.15.4"
}
