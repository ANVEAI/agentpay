# ElevenLabs — copy to `.env` and fill in. NEVER commit the real value (.env is gitignored).
# Get a key at https://elevenlabs.io (Account → API Keys).
ELEVENLABS_API_KEY=

# Optional: a specific narrator voice id. Defaults to a confident male voice (Brian).
ELEVENLABS_VOICE_ID=

# Optional overrides
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
